{
  // "workbench.colorTheme": "One Dark Pro Darker",
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontSize": 13,

  //agar Tailwind IntelliSense bisa deteksi pattern class di Dioxus
  "tailwindCSS.experimental.classRegex": [
    "class: \"([^\"]*)\"", // match: class: "..."
    "class:\\s*\\{\\s*\"([^\"]*)\"\\s*\\}" // deteksi yang lain nya juga
  ],
  // Biar file Rust dianggap HTML untuk Tailwind
  "tailwindCSS.includeLanguages": {
    "rust": "html"
  }
}
